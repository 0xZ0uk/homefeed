    {
     "tStartMs": 253320,
     "dDurationMs": 1890,
     "segs": [
      {
       "utf8": "to the current at the center of the wire,"
      }
     ]
    },
    {
     "tStartMs": 255210,
     "dDurationMs": 2700,
     "segs": [
      {
       "utf8": "and they reinforce\nchanges along the surface,"
      }
     ]
    },
    {
     "tStartMs": 257910,
     "dDurationMs": 1530,
     "segs": [
      {
       "utf8": "but eddy currents get stronger"
      }
     ]
    },
    {
     "tStartMs": 259440,
     "dDurationMs": 1650,
     "segs": [
      {
       "utf8": "the faster the signal changes."
      }
     ]
    },
    {
     "tStartMs": 261090,
     "dDurationMs": 1170,
     "segs": [
      {
       "utf8": "And if you want more calls,"
      }
     ]
    },
    {
     "tStartMs": 262260,
     "dDurationMs": 1020,
     "segs": [
      {
       "utf8": "you need more bands,"
      }
     ]
    },
    {
     "tStartMs": 263280,
     "dDurationMs": 1980,
     "segs": [
      {
       "utf8": "which use higher and higher frequencies."
      }
     ]
    },
    {
     "tStartMs": 265260,
     "dDurationMs": 1860,
     "segs": [
      {
       "utf8": "So soon the eddy currents\nare strong enough"
      }
     ]
    },
    {
     "tStartMs": 267120,
     "dDurationMs": 3210,
     "segs": [
      {
       "utf8": "to cancel out the oscillation\nin the center of the wire."
      }
     ]
    },
    {
     "tStartMs": 270330,
     "dDurationMs": 2670,
     "segs": [
      {
       "utf8": "But if the signal can only\ntravel along the wire's surface,"
      }
     ]
    },
    {
     "tStartMs": 273000,
     "dDurationMs": 2250,
     "segs": [
      {
       "utf8": "it's limited to a smaller cross section."
      }
     ]
    },
    {
     "tStartMs": 275250,
     "dDurationMs": 2430,
     "segs": [
      {
       "utf8": "So resistance goes up and\nhigher frequency signals"
      }
     ]
    },
    {
     "tStartMs": 277680,
     "dDurationMs": 2300,
     "segs": [
      {
       "utf8": "can't travel very far\nbefore they're absorbed."
      }
     ]
    },
    {
     "tStartMs": 280860,
     "dDurationMs": 2400,
     "segs": [
      {
       "utf8": "For a while, telephone companies\nwere able to work around"
      }
     ]
    },
    {
     "tStartMs": 283260,
     "dDurationMs": 3240,
     "segs": [
      {
       "utf8": "the high loss by boosting\nsignals every few kilometers."
      }
     ]
    },
    {
     "tStartMs": 286500,
     "dDurationMs": 3360,
     "segs": [
      {
       "utf8": "But past 65 megahertz, well,\nthe high frequencies died off"
      }
     ]
    },
    {
     "tStartMs": 289860,
     "dDurationMs": 1740,
     "segs": [
      {
       "utf8": "in less than two kilometers,"
      }
     ]
    },
    {
     "tStartMs": 291600,
     "dDurationMs": 2370,
     "segs": [
      {
       "utf8": "so they were too impractical to use."
      }
     ]
    },
    {
     "tStartMs": 293970,
     "dDurationMs": 2010,
     "segs": [
      {
       "utf8": "And this trade-off between signal power"
      }
     ]
    },
    {
     "tStartMs": 295980,
     "dDurationMs": 3870,
     "segs": [
      {
       "utf8": "and data rate was actually\ndiscovered back in 1948."
      }
     ]
    },
    {
     "tStartMs": 299850,
     "dDurationMs": 2820,
     "segs": [
      {
       "utf8": "The Shannon-Hartley theorem\ndescribed the maximum capacity"
      }
     ]
    },
    {
     "tStartMs": 302670,
     "dDurationMs": 1620,
     "segs": [
      {
       "utf8": "of a communication channel based on"
      }
     ]
    },
    {
     "tStartMs": 304290,
     "dDurationMs": 2250,
     "segs": [
      {
       "utf8": "the signal power, noise, and bandwidth,"
      }
     ]
    },
    {
     "tStartMs": 306540,
     "dDurationMs": 1260,
     "segs": [
      {
       "utf8": "or the difference between the highest"
      }
     ]
    },
    {
     "tStartMs": 307800,
     "dDurationMs": 1500,
     "segs": [
      {
       "utf8": "and lowest frequencies."
      }
     ]
    },
    {
     "tStartMs": 309300,
     "dDurationMs": 1440,
     "segs": [
      {
       "utf8": "The best way to increase capacity"
      }
     ]
    },
    {
     "tStartMs": 310740,
     "dDurationMs": 1623,
     "segs": [
      {
       "utf8": "is to increase the bandwidth."
      }
     ]
    },
    {
     "tStartMs": 313560,
     "dDurationMs": 2010,
     "segs": [
      {
       "utf8": "But they'd already reached\nthe limit for copper."
      }
     ]
    },
    {
     "tStartMs": 315570,
     "dDurationMs": 2650,
     "segs": [
      {
       "utf8": "The telecoms industry didn't\nhave another alternative,"
      }
     ]
    },
    {
     "tStartMs": 318220,
     "dDurationMs": 833,
     "segs": [
      {
       "utf8": "(dramatic music)"
      }
     ]
    },
    {
     "tStartMs": 319053,
     "dDurationMs": 1497,
     "segs": [
      {
       "utf8": "but then they saw the light."
      }
     ]
    },
    {
     "tStartMs": 320550,
     "dDurationMs": 3420,
     "segs": [
      {
       "utf8": "Visible light has frequencies\nin the hundreds of terahertz."
      }
     ]
    },
    {
     "tStartMs": 323970,
     "dDurationMs": 1897,
     "segs": [
      {
       "utf8": "As one researcher for Bell Labs put it,"
      }
     ]
    },
    {
     "tStartMs": 325867,
     "dDurationMs": 2940,
     "segs": [
      {
       "utf8": "\"the possibility of\nextremely high frequencies"
      }
     ]
    },
    {
     "tStartMs": 328807,
     "dDurationMs": 3030,
     "segs": [
      {
       "utf8": "\"and accordingly vastly\nwider bands of frequencies"
      }
     ]
    },
    {
     "tStartMs": 331837,
     "dDurationMs": 2250,
     "segs": [
      {
       "utf8": "\"appeared as a fabulous El Dorado,"
      }
     ]
    },
    {
     "tStartMs": 334087,
     "dDurationMs": 1640,
     "segs": [
      {
       "utf8": "\"always beckoning us onward.\""
      }
     ]
    },
    {
     "tStartMs": 337470,
     "dDurationMs": 1080,
     "segs": [
      {
       "utf8": "But if you're going to use light,"
      }
     ]
    },
    {
     "tStartMs": 338550,
     "dDurationMs": 1440,
     "segs": [
      {
       "utf8": "there are two problems."
      }
     ]
    },
    {
     "tStartMs": 339990,
     "dDurationMs": 1530,
     "segs": [
      {
       "utf8": "First, there wasn't a strong enough"
      }
     ]
    },
    {
     "tStartMs": 341520,
     "dDurationMs": 1530,
     "segs": [
      {
       "utf8": "light source to send a signal."
      }
     ]
    },
    {
     "tStartMs": 343050,
     "dDurationMs": 2100,
     "segs": [
      {
       "utf8": "A light bulb couldn't\nproduce enough power."
      }
     ]
    },
    {
     "tStartMs": 345150,
     "dDurationMs": 2100,
     "segs": [
      {
       "utf8": "There just weren't any options."
      }
     ]
    },
    {
     "tStartMs": 347250,
     "dDurationMs": 1620,
     "segs": [
      {
       "utf8": "- And along in 1960,"
      }
     ]
    },
    {
     "tStartMs": 348870,
     "dDurationMs": 1980,
     "segs": [
      {
       "utf8": "Ted Maiman invented the laser."
      }
     ]
    },
    {
     "tStartMs": 350850,
     "dDurationMs": 3000,
     "segs": [
      {
       "utf8": "- [Reporter] A science fiction\nweapon that melts steel,"
      }
     ]
    },
    {
     "tStartMs": 353850,
     "dDurationMs": 2700,
     "segs": [
      {
       "utf8": "a death ray that could be more deadly"
      }
     ]
    },
    {
     "tStartMs": 356550,
     "dDurationMs": 1320,
     "segs": [
      {
       "utf8": "than a nuclear bomb."
      }
     ]
    },
    {
     "tStartMs": 357870,
     "dDurationMs": 1980,
     "segs": [
      {
       "utf8": "It's a beam of light."
      }
     ]
    },
    {
     "tStartMs": 359850,
     "dDurationMs": 2610,
     "segs": [
      {
       "utf8": "This is called a laser."
      }
     ]
    },
    {
     "tStartMs": 362460,
     "dDurationMs": 1717,
     "segs": [
      {
       "utf8": "- [Henry] There's a running\njoke that the laser was"
      }
     ]
    },
    {
     "tStartMs": 364177,
     "dDurationMs": 1883,
     "segs": [
      {
       "utf8": "\"a solution looking for a problem,\""
      }
     ]
    },
    {
     "tStartMs": 366060,
     "dDurationMs": 2159,
     "segs": [
      {
       "utf8": "but that's not really true."
      }
     ]
    },
    {
     "tStartMs": 368219,
     "dDurationMs": 2251,
     "segs": [
      {
       "utf8": "- [Donald] It rejuvenated the interest"
      }
     ]
    },
    {
     "tStartMs": 370470,
     "dDurationMs": 3000,
     "segs": [
      {
       "utf8": "in possible optical communications."
      }
     ]
    },
    {
     "tStartMs": 373470,
     "dDurationMs": 1747,
     "segs": [
      {
       "utf8": "- As one Bell Labs engineer said,"
      }
     ]
    },
    {
     "tStartMs": 375217,
     "dDurationMs": 1730,
     "segs": [
      {
       "utf8": "\"Think of all this bandwidth!\""
      }
     ]
    },
    {
     "tStartMs": 378090,
     "dDurationMs": 2820,
     "segs": [
      {
       "utf8": "But they couldn't figure\nout the second problem."
      }
     ]
    },
    {
     "tStartMs": 380910,
     "dDurationMs": 2490,
     "segs": [
      {
       "utf8": "Glass is not as clear as it looks."
      }
     ]
    },
    {
     "tStartMs": 383400,
     "dDurationMs": 3120,
     "segs": [
      {
       "utf8": "Only a small amount of light\nactually makes it through."
      }
     ]
    },
    {
     "tStartMs": 386520,
     "dDurationMs": 2370,
     "segs": [
      {
       "utf8": "In fact, only a year after\nthe laser's invention,"
      }
     ]
    },
    {
     "tStartMs": 388890,
     "dDurationMs": 3180,
     "segs": [
      {
       "utf8": "a Bell Labs scientist started\nlooking into fiber optics."
      }
     ]
    },
    {
     "tStartMs": 392070,
     "dDurationMs": 2100,
     "segs": [
      {
       "utf8": "His boss told him to check its loss,"
      }
     ]
    },
    {
     "tStartMs": 394170,
     "dDurationMs": 1650,
     "segs": [
      {
       "utf8": "or how much a light signal weakens"
      }
     ]
    },
    {
     "tStartMs": 395820,
     "dDurationMs": 2220,
     "segs": [
      {
       "utf8": "as it travels through the glass."
      }
     ]
    },
    {
     "tStartMs": 398040,
     "dDurationMs": 2220,
     "segs": [
      {
       "utf8": "Now, signal loss is\nmeasured with decibels,"
      }
     ]
    },
    {
     "tStartMs": 400260,
     "dDurationMs": 2190,
     "segs": [
      {
       "utf8": "similar to how you measure audio volume."
      }
     ]
    },
    {
     "tStartMs": 402450,
     "dDurationMs": 2220,
     "segs": [
      {
       "utf8": "Both are on a logarithmic scale,"
      }
     ]
    },
    {
     "tStartMs": 404670,
     "dDurationMs": 1980,
     "segs": [
      {
       "utf8": "but while volume uses sound pressure,"
      }
     ]
    },
    {
     "tStartMs": 406650,
     "dDurationMs": 1920,
     "segs": [
      {
       "utf8": "loss uses signal power."
      }
     ]
    },
    {
     "tStartMs": 408570,
     "dDurationMs": 1920,
     "segs": [
      {
       "utf8": "His boss said it would only be worthwhile"
      }
     ]
    },
    {
     "tStartMs": 410490,
     "dDurationMs": 2730,
     "segs": [
      {
       "utf8": "if the loss was less than\n20 decibels a kilometer,"
      }
     ]
    },
    {
     "tStartMs": 413220,
     "dDurationMs": 1500,
     "segs": [
      {
       "utf8": "so it was comparable to copper."
      }
     ]
    },
    {
     "tStartMs": 414720,
     "dDurationMs": 3180,
     "segs": [
      {
       "utf8": "But when he checked the\nloss for the best fibers,"
      }
     ]
    },
    {
     "tStartMs": 417900,
     "dDurationMs": 3150,
     "segs": [
      {
       "utf8": "a thousand decibels a kilometer."
      }
     ]
    },
    {
     "tStartMs": 421050,
     "dDurationMs": 1920,
     "segs": [
      {
       "utf8": "To understand just how bad that was,"
      }
     ]
    },
    {
     "tStartMs": 422970,
     "dDurationMs": 2250,
     "segs": [
      {
       "utf8": "imagine a leaky truck carrying sand"
      }
     ]
    },
    {
     "tStartMs": 425220,
     "dDurationMs": 1650,
     "segs": [
      {
       "utf8": "over one kilometer."
      }
     ]
    },
    {
     "tStartMs": 426870,
     "dDurationMs": 1920,
     "segs": [
      {
       "utf8": "If the truck starts with 100 kilograms,"
      }
     ]
    },
    {
     "tStartMs": 428790,
     "dDurationMs": 1530,
     "segs": [
      {
       "utf8": "and it ends up with one,"
      }
     ]
    },
    {
     "tStartMs": 430320,
     "dDurationMs": 3090,
     "segs": [
      {
       "utf8": "well, that represents a loss\nof 20 decibels per kilometer."
      }
     ]
    },
    {
     "tStartMs": 433410,
     "dDurationMs": 2280,
     "segs": [
      {
       "utf8": "That's only 1% of the signal left."
      }
     ]
    },
    {
     "tStartMs": 435690,
     "dDurationMs": 1980,
     "segs": [
      {
       "utf8": "It's what was happening with copper,"
      }
     ]
    },
    {
     "tStartMs": 437670,
     "dDurationMs": 2370,
     "segs": [
      {
       "utf8": "bad but still manageable."
      }
     ]
    },
    {
     "tStartMs": 440040,
     "dDurationMs": 2070,
     "segs": [
      {
       "utf8": "A loss of a thousand decibels a kilometer"
      }
     ]
    },
    {
     "tStartMs": 442110,
     "dDurationMs": 3390,
     "segs": [
      {
       "utf8": "is like starting with the mass\nof the observable universe"
      }
     ]
    },
    {
     "tStartMs": 445500,
     "dDurationMs": 3630,
     "segs": [
      {
       "utf8": "and ending up with less than\nthe mass of a single atom."
      }
     ]
    },
    {
     "tStartMs": 449130,
     "dDurationMs": 2040,
     "segs": [
      {
       "utf8": "To be practical, these\nfibers would need to improve"
      }
     ]
    },
    {
     "tStartMs": 451170,
     "dDurationMs": 2640,
     "segs": [
      {
       "utf8": "by a factor of 10 the 98th."
      }
     ]
    },
    {
     "tStartMs": 453810,
     "dDurationMs": 2340,
     "segs": [
      {
       "utf8": "It sounded impossible. It would\nhave to be one of the most"
      }
     ]
    },
    {
     "tStartMs": 456150,
     "dDurationMs": 3000,
     "segs": [
      {
       "utf8": "absurd engineering\nimprovements in history."
      }
     ]
    },
    {
     "tStartMs": 459150,
     "dDurationMs": 1620,
     "segs": [
      {
       "utf8": "So Bell Labs gave up."
      }
     ]
    },
    {
     "tStartMs": 460770,
     "dDurationMs": 2430,
     "segs": [
      {
       "utf8": "And fiber optics might\nhave died right there"
      }
     ]
    },
    {
     "tStartMs": 463200,
     "dDurationMs": 1743,
     "segs": [
      {
       "utf8": "if it wasn't for one man."
      }
     ]
    },
    {
     "tStartMs": 465810,
     "dDurationMs": 1410,
     "segs": [
      {
       "utf8": "Charles Kao."
      }
     ]
    },
    {
     "tStartMs": 467220,
     "dDurationMs": 1560,
     "segs": [
      {
       "utf8": "In 1960, he started working"
      }
     ]
    },
    {
     "tStartMs": 468780,
     "dDurationMs": 1590,
     "segs": [
      {
       "utf8": "for an English telecoms lab"
      }
     ]
    },
    {
     "tStartMs": 470370,
     "dDurationMs": 1560,
     "segs": [
      {
       "utf8": "that was looking for a way to communicate"
      }
     ]
    },
    {
     "tStartMs": 471930,
     "dDurationMs": 1440,
     "segs": [
      {
       "utf8": "with higher frequencies,"
      }
     ]
    },
    {
     "tStartMs": 473370,
     "dDurationMs": 2010,
     "segs": [
      {
       "utf8": "but not with fiber optics."
      }
     ]
    },
    {
     "tStartMs": 475380,
     "dDurationMs": 2250,
     "segs": [
      {
       "utf8": "Kao's boss said that it\nwas \"a wild goose chase\""
      }
     ]
    },
    {
     "tStartMs": 477630,
     "dDurationMs": 2370,
     "segs": [
      {
       "utf8": "and the rest of the lab agreed."
      }
     ]
    },
    {
     "tStartMs": 480000,
     "dDurationMs": 1770,
     "segs": [
      {
       "utf8": "But Kao kept coming back to it,"
      }
     ]
    },
    {
     "tStartMs": 481770,
     "dDurationMs": 2707,
     "segs": [
      {
       "utf8": "asking, \"Why is glass so lossy"
      }
     ]
    },
    {
     "tStartMs": 484477,
     "dDurationMs": 1680,
     "segs": [
      {
       "utf8": "\"and can we remove those factors"
      }
     ]
    },
    {
     "tStartMs": 486157,
     "dDurationMs": 2693,
     "segs": [
      {
       "utf8": "\"or are they intrinsic to the material?\""
      }
     ]
    },
    {
     "tStartMs": 488850,
     "dDurationMs": 870,
     "segs": [
      {
       "utf8": "If it was the latter,"
      }
     ]
    },
    {
     "tStartMs": 489720,
     "dDurationMs": 2220,
     "segs": [
      {
       "utf8": "then fiber would be dead in the water."
      }
     ]
    },
    {
     "tStartMs": 491940,
     "dDurationMs": 3420,
     "segs": [
      {
       "utf8": "But if not, then maybe it had a chance."
      }
     ]
    },
    {
     "tStartMs": 495360,
     "dDurationMs": 1110,
     "segs": [
      {
       "utf8": "So the question was:"
      }
     ]
    },
    {
     "tStartMs": 496470,
     "dDurationMs": 1980,
     "segs": [
      {
       "utf8": "Why was the loss so high?"
      }
     ]
    },
    {
     "tStartMs": 498450,
     "dDurationMs": 1800,
     "segs": [
      {
       "utf8": "Well, you might think it's because light"
      }
     ]
    },
    {
     "tStartMs": 500250,
     "dDurationMs": 2430,
     "segs": [
      {
       "utf8": "is exiting through the\nsides of this fiber,"
      }
     ]
    },
    {
     "tStartMs": 502680,
     "dDurationMs": 2220,
     "segs": [
      {
       "utf8": "but glass is really\ngood at trapping light,"
      }
     ]
    },
    {
     "tStartMs": 504900,
     "dDurationMs": 1530,
     "segs": [
      {
       "utf8": "even through bends."
      }
     ]
    },
    {
     "tStartMs": 506430,
     "dDurationMs": 990,
     "segs": [
      {
       "utf8": "Here's how."
      }
     ]
    },
    {
     "tStartMs": 507420,
     "dDurationMs": 1890,
     "segs": [
      {
       "utf8": "I've got a bucket of propylene glycol here"
      }
     ]
    },
    {
     "tStartMs": 509310,
     "dDurationMs": 1170,
     "segs": [
      {
       "utf8": "and a green laser."
      }
     ]
    },
    {
     "tStartMs": 510480,
     "dDurationMs": 1760,
     "segs": [
      {
       "utf8": "When I remove the tape,"
      }
     ]
    },
    {
     "tStartMs": 512240,
     "dDurationMs": 3850,
     "segs": [
      {
       "utf8": "(gentle dramatic music)"
      }
     ]
    },
    {
     "tStartMs": 516090,
     "dDurationMs": 3450,
     "segs": [
      {
       "utf8": "the laser bounces one, two, three times."
      }
     ]
    },
    {
     "tStartMs": 519540,
     "dDurationMs": 1680,
     "segs": [
      {
       "utf8": "And there are two things\nworking together here"
      }
     ]
    },
    {
     "tStartMs": 521220,
     "dDurationMs": 2130,
     "segs": [
      {
       "utf8": "that actually trap the light."
      }
     ]
    },
    {
     "tStartMs": 523350,
     "dDurationMs": 2970,
     "segs": [
      {
       "utf8": "See, light travels slower in\nsome materials than others,"
      }
     ]
    },
    {
     "tStartMs": 526320,
     "dDurationMs": 3180,
     "segs": [
      {
       "utf8": "and it travels as a wave\nshown here as a line of crests"
      }
     ]
    },
    {
     "tStartMs": 529500,
     "dDurationMs": 3150,
     "segs": [
      {
       "utf8": "with the beam always pointing\nperpendicular to that line."
      }
     ]
    },
    {
     "tStartMs": 532650,
     "dDurationMs": 2100,
     "segs": [
      {
       "utf8": "When the wave meets a\nboundary at an angle,"
      }
     ]
    },
    {
     "tStartMs": 534750,
     "dDurationMs": 3450,
     "segs": [
      {
       "utf8": "one end of the crest crosses\ninto the new material first,"
      }
     ]
    },
    {
     "tStartMs": 538200,
     "dDurationMs": 2280,
     "segs": [
      {
       "utf8": "and it changes speed before the rest."
      }
     ]
    },
    {
     "tStartMs": 540480,
     "dDurationMs": 2190,
     "segs": [
      {
       "utf8": "If light travels slower\nin that new material,"
      }
     ]
    },
    {
     "tStartMs": 542670,
     "dDurationMs": 3150,
     "segs": [
      {
       "utf8": "then that end drags\nbehind and the beam bends"
      }
     ]
    },
    {
     "tStartMs": 545820,
     "dDurationMs": 2520,
     "segs": [
      {
       "utf8": "or refracts away from the boundary."
      }
     ]
    },
    {
     "tStartMs": 548340,
     "dDurationMs": 2730,
     "segs": [
      {
       "utf8": "How much it bends depends on\nthe angle it hits the boundary"
      }
     ]
    },
    {
     "tStartMs": 551070,
     "dDurationMs": 2370,
     "segs": [
      {
       "utf8": "and on how much each\nmaterial slows light down,"
      }
     ]
    },
    {
     "tStartMs": 553440,
     "dDurationMs": 2670,
     "segs": [
      {
       "utf8": "which is described by\ntheir index of refraction."
      }
     ]
    },
    {
     "tStartMs": 556110,
     "dDurationMs": 2223,
     "segs": [
      {
       "utf8": "This relationship is\ndefined by Snell's Law."
      }
     ]
    },
    {
     "tStartMs": 559650,
     "dDurationMs": 1950,
     "segs": [
      {
       "utf8": "Now if light is moving from a material"
      }
     ]
    },
    {
     "tStartMs": 561600,
     "dDurationMs": 1710,
     "segs": [
      {
       "utf8": "with a higher index of refraction"
      }
     ]
    },
    {
     "tStartMs": 563310,
     "dDurationMs": 1710,
     "segs": [
      {
       "utf8": "into one with a lower index,"
      }
     ]
    },
    {
     "tStartMs": 565020,
     "dDurationMs": 2220,
     "segs": [
      {
       "utf8": "like propylene glycol to air,"
      }
     ]
    },
    {
     "tStartMs": 567240,
     "dDurationMs": 2430,
     "segs": [
      {
       "utf8": "well then one part of\nthe wave crest speeds up"
      }
     ]
    },
    {
     "tStartMs": 569670,
     "dDurationMs": 2220,
     "segs": [
      {
       "utf8": "and the beam bends toward the boundary."
      }
     ]
    },
    {
     "tStartMs": 571890,
     "dDurationMs": 2100,
     "segs": [
      {
       "utf8": "But as you increase\nthe angle of the light,"
      }
     ]
    },
    {
     "tStartMs": 573990,
     "dDurationMs": 3540,
     "segs": [
      {
       "utf8": "the refracted beam gets closer\nand closer to the boundary"
      }
     ]
    },
    {
     "tStartMs": 577530,
     "dDurationMs": 1890,
     "segs": [
      {
       "utf8": "until it's running right along it."
      }
     ]
    },
    {
     "tStartMs": 579420,
     "dDurationMs": 2160,
     "segs": [
      {
       "utf8": "That's the critical angle."
      }
     ]
    },
    {
     "tStartMs": 581580,
     "dDurationMs": 1890,
     "segs": [
      {
       "utf8": "A little bit more and all the light"
      }
     ]
    },
    {
     "tStartMs": 583470,
     "dDurationMs": 2130,
     "segs": [
      {
       "utf8": "reflects back into the glycol."
      }
     ]
    },
    {
     "tStartMs": 585600,
     "dDurationMs": 1680,
     "segs": [
      {
       "utf8": "That's total internal reflection,"
      }
     ]
    },
    {
     "tStartMs": 587280,
     "dDurationMs": 1530,
     "segs": [
      {
       "utf8": "and you get the exact critical angle"
      }
     ]
    },
    {
     "tStartMs": 588810,
     "dDurationMs": 2460,
     "segs": [
      {
       "utf8": "by setting the angle of\nrefraction to 90 degrees"
      }
     ]
    },
    {
     "tStartMs": 591270,
     "dDurationMs": 2010,
     "segs": [
      {
       "utf8": "and then rearranging Snell's Law."
      }
     ]
    },
    {
     "tStartMs": 593280,
     "dDurationMs": 2910,
     "segs": [
      {
       "utf8": "- The key of it is the\nbigger the difference"
      }
     ]
    },
    {
     "tStartMs": 596190,
     "dDurationMs": 1860,
     "segs": [
      {
       "utf8": "in index of refraction,"
      }
     ]
    },
    {
     "tStartMs": 598050,
     "dDurationMs": 2220,
     "segs": [
      {
       "utf8": "the more powerful this effect is."
      }
     ]
    }
   ]
  }
 }
}
