# Copy to .env and adjust.

# Python (api + worker)
DATA_DIR=./data
DATABASE_PATH=./data/homefeed.sqlite
FEED_SIZE=15
# Local time; set TZ for the worker (e.g. TZ=Europe/Lisbon) so it matches your day.
FEED_REFRESH_TIME=06:00
# Optional duration bounds for feed videos, in seconds (unset = no bound).
# FEED_MIN_DURATION_SECONDS=120
# FEED_MAX_DURATION_SECONDS=5400
FEED_CANDIDATE_DAYS=7
LLM_PROVIDER=none

# Web (server functions + auth)
API_URL=http://localhost:8000
# Password for the single-user login.
APP_PASSWORD=change-me
# Encrypts and signs the session cookie; at least 32 characters (`openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-long-random-string
