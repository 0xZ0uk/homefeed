# Copy to .env and adjust.
#
# Settings marked [Settings] can also be changed on the app's Settings page, which stores
# them in the database: there, the value here is only the default, and a value changed in
# the app wins until it is reset to default. The time zone is set there too; its default is
# the system's (TZ).

# Python (api + worker)
DATA_DIR=./data
DATABASE_PATH=./data/homefeed.sqlite
# [Settings] Videos per daily feed.
FEED_SIZE=20
# [Settings] Feed slots reserved for exploring channels with few or no ratings.
FEED_EXPLORATION_SLOTS=3
# [Settings] The most of a feed one followed topic (a subscribed tag) may take, as a share of
# its size, from 0.1 to 1 (1 = no limit): 0.4 of 20 videos is 8. Later picks of a full topic
# only fill the places nothing else can.
FEED_MAX_TOPIC_SHARE=0.4
# Run the worker's scheduled jobs inside the API process (one process instead of api +
# worker; don't also run a worker). Unset/false = a separate worker, as in Docker Compose.
# RUN_WORKER_IN_API=false
# [Settings] Local time the daily feed is built, in the time zone picked in Settings
# (default: the system's; set TZ, e.g. TZ=Europe/Lisbon, if the server's isn't yours).
FEED_REFRESH_TIME=06:00
# [Settings] Local time when the worker trains the ranking model on your ratings (nightly).
MODEL_TRAINING_TIME=03:00
# Optional local time for a daily live smoke test of the YouTube Gateway (uses the
# network; results show on /status). Unset = never.
# GATEWAY_SMOKE_TEST_TIME=05:30
# [Settings] Optional duration bounds for feed videos, in seconds (unset = no bound).
# FEED_MIN_DURATION_SECONDS=120
# FEED_MAX_DURATION_SECONDS=5400
FEED_CANDIDATE_DAYS=7
# Embeddings for content features. openrouter: OpenRouter's embeddings API (needs
# OPENROUTER_API_KEY; the model must support 384 dimensions, e.g.
# perplexity/pplx-embed-v1-0.6b). local: a fastembed (ONNX) model (BAAI/bge-small-en-v1.5)
# downloaded into DATA_DIR/models. Changing the model re-embeds the library on the next
# enrichment run (or `uv run python -m homefeed_core.enricher`); the ranking model then
# waits for retraining (nightly, or `uv run python -m homefeed_core.trainer`).
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=perplexity/pplx-embed-v1-0.6b
# [Settings] LLM tagging of videos (topic, depth, clickbait, rage-bait), used as ranking features.
# openrouter (default): the hosted OpenRouter API (https://openrouter.ai); tagging is
# skipped until OPENROUTER_API_KEY is set. ollama: a local Ollama server. none: off.
LLM_PROVIDER=openrouter
# [Settings] API key from https://openrouter.ai/settings/keys. A key entered in Settings is
# stored in the database (in plain text) and used for tagging; embeddings
# (EMBEDDING_PROVIDER=openrouter) use the key set here.
OPENROUTER_API_KEY=
# [Settings] Model; empty = provider default
# (openrouter: google/gemini-2.5-flash-lite, ollama: llama3.1:8b).
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
# API base URL; empty = provider default
# (openrouter: https://openrouter.ai/api/v1, ollama: http://localhost:11434).
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
# [Settings] At most this many videos are tagged per enrichment run (bounds cost).
LLM_MAX_TAGS_PER_RUN=200
# Similarity calibration, measured per embedding model (homefeed_core.embeddings):
# unset uses the model's values. TAG_MERGE_THRESHOLD: a proposed tag at least this
# cosine-similar to an existing tag becomes an alias of it (higher = fewer merges).
# SIMILARITY_FLOOR: below it a video counts as unrelated to a rated video.
# TAG_MERGE_THRESHOLD=
# SIMILARITY_FLOOR=
# [Settings] At most this many new videos per subscribed tag per day are discovered by searching
# YouTube for the tag (0 = off).
TAG_DISCOVERY_PER_DAY=10
# [Settings] SponsorBlock segments the watch page skips, comma-separated (empty = off). Others:
# intro, outro, preview, hook, music_offtopic, filler.
SPONSORBLOCK_URL=https://sponsor.ajay.app
SPONSORBLOCK_CATEGORIES=sponsor,selfpromo,interaction

# Web (server functions + auth)
API_URL=http://localhost:8000
# Password for the single-user login.
APP_PASSWORD=change-me
# Encrypts and signs the session cookie; at least 32 characters (`openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-long-random-string

# yt-dlp: download newer releases into DATA_DIR/ytdlp (used from the next restart); the
# desktop app turns this on. HOMEFEED_JS_RUNTIME: a Node-compatible executable for
# yt-dlp's YouTube challenge solver (default: Deno on PATH).
YTDLP_AUTO_UPDATE=false
# HOMEFEED_JS_RUNTIME=
# [Settings] YouTube cookies, for when it asks to "sign in to confirm you're not a bot" (it
# does that to IPs it throttles). YTDLP_COOKIES_FROM_BROWSER: yt-dlp's --cookies-from-browser
# value, BROWSER[+KEYRING][:PROFILE][::CONTAINER], e.g. firefox, chromium or, for a
# Firefox-based browser, firefox:~/.config/zen/<profile>; the Settings page lists the
# profiles it finds. YTDLP_COOKIES_FILE (not on the Settings page; e.g. for Docker, which
# has no browser): a Netscape-format cookies.txt (yt-dlp writes refreshed cookies back to it).
# YTDLP_COOKIES_FROM_BROWSER=
# YTDLP_COOKIES_FILE=
# Auth mode: server (default, password login) or desktop (the Electron shell: no login
# page; the shell opens /desktop-auth?token=DESKTOP_TOKEN, which starts the session).
# Desktop mode also needs HOST=127.0.0.1 and PORT for the web process (see README).
# HOMEFEED_MODE=server
# Desktop mode only (replaces APP_PASSWORD): per-launch secret the shell generates;
# at least 32 characters.
# DESKTOP_TOKEN=
