{
  "name": "lenstube",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "e2e": "turbo run e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "reembed": "uv run python -m homefeed_core.enricher --reembed",
    "enrich": "uv run python -m homefeed_core.enricher",
    "tag": "uv run python -m homefeed_core.llm_tags"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "0.9.6"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
