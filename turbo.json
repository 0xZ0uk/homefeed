{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": ["pyproject.toml", "uv.lock"],
  "tasks": {
    "openapi": {
      "inputs": ["src/**", "$TURBO_ROOT$/packages/core/src/**"],
      "outputs": ["openapi.json"]
    },
    "generate": {
      "dependsOn": ["@homefeed/api#openapi"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**"],
      "env": ["API_URL"]
    },
    "test": {
      "dependsOn": ["^generate"]
    },
    "lint": {
      "dependsOn": ["^generate"]
    },
    "check-types": {
      "dependsOn": ["^generate"]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "env": ["API_URL"],
      "persistent": true,
      "cache": false
    }
  }
}
